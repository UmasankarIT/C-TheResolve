# CivicResolve Environment Variables

# Google Gemini API Key (Get from Google AI Studio: https://aistudio.google.com/)
# If left empty, CivicResolve automatically runs in high-fidelity offline/demo mode with zero crashes.
GEMINI_API_KEY=

# PostgreSQL + PostGIS (Optional for local persistent storage; in-memory store is active by default)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5455/civicresolve

# Storage (MinIO / S3)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=miniopassword

# Session signing secret. REQUIRED in production — sessions are forgeable without it.
CIVRES_JWT_SECRET=

# Government of India Open Government Data (data.gov.in) — real public-data fusion.
# Free key: https://data.gov.in (profile -> API key). Leave empty to run on the
# curated contextual baseline instead; the demand engine degrades gracefully.
DATA_GOV_IN_API_KEY=
# Resource id of a Primary Census Abstract resource (dataset page -> "API" -> resource id)
DATA_GOV_IN_PCA_RESOURCE=
# Column headers to filter/join on, if the resource names them differently
DATA_GOV_IN_PCA_STATE_FIELD=State Name
DATA_GOV_IN_PCA_DISTRICT_FIELD=District Name
DATA_GOV_IN_PCA_STATE=Andhra Pradesh
