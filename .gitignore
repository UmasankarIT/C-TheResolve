# ============================================================
# CivicResolve root .gitignore
# Protect secrets, build artifacts, and regenerable files only.
# .env.example is intentionally tracked (documented template).
# ============================================================

# --- Environment / Secrets (never commit real values) ---
.env
.env.local
.env.*.local
.env.production
.env.development
*.pem
*.p12
*.key
!*.example

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Next.js build output ---
.next/
out/
build/
!src/app/api/admin/demand-signals/build/
!src/app/api/admin/demand-signals/build/**
dist/
coverage/
*.tsbuildinfo
next-env.d.ts

# --- ML / Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- Logs & Caches ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.cache/
.turbo/
.lock-wscript

# --- OS / Editor junk ---
Thumbs.db
Desktop.ini
.DS_Store
*.swp
.idea/
*.iml
.vscode/
(Fuse)
._*